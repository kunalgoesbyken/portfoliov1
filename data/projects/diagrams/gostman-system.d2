direction: right

desktop: Desktop app\nWails + React {
  class: client
  tooltip: "A Wails shell around the React UI. App.SendRequest in gostman-gui/app.go calls engine.Send in the same process, so there is no network hop and no CORS. It also reads and saves the workspace folder and starts the mock server and traffic capture."
}

web: Web app\nReact PWA, Vite {
  class: client
  tooltip: "The same React UI built with the web Vite config. lib/backend/web.js posts every request to /api/proxy, because browsers block cross-origin calls. WebSocket traffic goes straight from the browser, and scripts run in a fresh Web Worker each."
}

hosted: gostman.com on Vercel {
  class: zone
  proxy: /api/proxy\nGo function {
    class: service
    tooltip: "api/proxy.go takes an engine.Request as JSON and returns an engine.Response. Its hosted policy blocks private addresses, cuts responses at 3 MB and caps timeouts at 30 s. The same handler runs in gostman relay and gostman serve."
  }
}

runner: gostman run\nrunner + goja {
  class: service
  tooltip: "The Go runner package loads a collection, plans the run, and calls the bundled JavaScript inside goja for scripts, checks and extract rules. It sends through the engine, rpc or mcpclient and returns a report with an exit code."
}

mcp: gostman mcp\nagent.Desk {
  class: service
  tooltip: "Serves 17 tools such as send_request and run_folder over stdio or loopback HTTP with a bearer token, plus one tool per request tagged with --expose-tag. It wraps a runner session, fills secrets in only for hosts your own requests already call, and scrubs them from every reply."
}

agent: Coding agent {
  class: model
  tooltip: "Claude Code, Codex or Cursor, connected over the Model Context Protocol. It sees request ids, names and responses with secret values replaced by their names."
}

engine: engine + rpc + mcpclient\nGo packages {
  class: service
  tooltip: "engine prepares and sends requests: variables, auth, body encoding, cookies, redirects, proxies and certificates for HTTP, GraphQL, SOAP, SSE, TCP, UDP and NATS. rpc handles gRPC and mcpclient handles MCP servers. The engine keeps no state between requests."
}

files: Collections\nYAML in Git {
  class: store
  tooltip: "The workspace package reads a folder of plain YAML, one file per request. Tokens, cookies and history never go into it. A bounded reader pool opens 5,000 requests in 5.4 s, down from 14.8 s."
}

api: Your APIs {
  class: external
  tooltip: "Any HTTP, gRPC, WebSocket, MQTT or MCP endpoint. There is no account and no telemetry, so nothing else is contacted for requests."
}

desktop -> engine: Wails binding
desktop -> files: open, save
web -> hosted.proxy: POST
hosted.proxy -> engine: hosted policy
agent -> mcp: MCP
mcp -> runner: session
runner -> engine: send
runner -> files: load
engine -> api: HTTP, gRPC, TCP
