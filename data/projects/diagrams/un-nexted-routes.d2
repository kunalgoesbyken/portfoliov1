pages: src/pages\n*.tsx {
  class: store
  tooltip: "The app code. index.tsx is /, about.tsx is /about and blog/[slug].tsx is a dynamic route. _app.tsx, _document.tsx and nested files that start with an underscore are skipped."
}

server: server.ts\nstartServer() {
  class: client
  tooltip: "Runs once when the server starts. It initialises the router first, then calls buildClient(), so routes and client chunks are ready before the first request."
}

router: router.ts\nglob to regex {
  class: service
  tooltip: "Bun.Glob scans src/pages once at startup. Each file becomes a URL pattern compiled to a regular expression with a capture group per [param], and match() returns the first route that fits along with its params."
}

build: build.ts\nBun.build {
  class: service
  tooltip: "Bundles client.tsx for the browser as ES modules with code splitting. A plugin supplies the virtual module unnexted:pages, a map from each page's file path to a literal import(), so every page becomes its own chunk in dist/. It runs at every server start."
}

dist: dist/\none chunk per page {
  class: store
  tooltip: "The bundle Bun.build writes: client.tsx as ES modules plus one chunk per page, split by the literal import() calls in unnexted:pages."
}

server -> router: 1 init
server -> build: 2 build
pages -> router: scan
build -> dist
