direction: right

browser: In your browser {
  class: zone
  app: App + useAppStore\nReact 19, Zustand {
    class: client
    tooltip: "One Zustand store holds mail per mailbox, filters, the open thread and the composer. Only the user and sign-in flag are persisted. A 30 second timer refetches the current view, and filtering and sorting run client side."
  }
  auth: /auth/callback\nstate check, sessionStorage {
    class: service
    tooltip: "Checks the random OAuth state against sessionStorage, sends the code to the token route and stores the returned access and refresh tokens in sessionStorage. Token refresh in services/auth.ts goes through the same route."
  }
  gmail: GmailService\nky, Promise.allSettled {
    class: service
    tooltip: "Calls the Gmail REST API directly with the stored access token. Messages are fetched in parallel with Promise.allSettled, so one failed message is skipped. HTML bodies are sanitised with DOMPurify before rendering."
  }
}

server: Next.js route handlers on Vercel {
  class: zone
  oauth: "/api/auth/token\nserver-only client secret" {
    class: service
    tooltip: "Exchanges the authorization code, and later the refresh token, for tokens at Google using GMAIL_CLIENT_SECRET, which is never sent to the browser."
  }
  chat: /api/chat\nstreamText, 4 tools {
    class: service
    tooltip: "Streams a Groq response with openEmail, navigateView, composeEmail and replyToEmail as Zod-typed tools. Each tool only returns an acknowledgement and none can send mail. The system prompt limits the model to email ids in the context."
  }
}

google: Google\nOAuth + Gmail API {
  class: external
  tooltip: "The token endpoint serves the code exchange and refresh. The Gmail API is called from the browser with the gmail.modify scope and the user's own access token."
}

groq: Groq\ngpt-oss-120b {
  class: model
  tooltip: "Receives the chat history plus a compact context: current view, selected email, filters and the ten most recent emails as 100 character snippets. Replies stream back token by token."
}

browser.auth -> server.oauth: code / refresh token
server.oauth -> google: token exchange
browser.auth -> browser.gmail: access token
browser.app -> browser.gmail: list / send
browser.gmail -> google: REST + Bearer
browser.app <-> server.chat: prompt / tool calls
server.chat -> groq: stream
