direction: right

index: index command {
  class: zone
  walk: Walker + delta\nignore, SHA-256 {
    class: service
    tooltip: "walker.rs honours .gitignore, keeps supported file types and skips lockfiles. delta.rs hashes every file and compares hash and mtime with the cache, so only new or changed files continue and deleted ones are purged."
  }
  chunk: Chunker\ntree-sitter {
    class: service
    tooltip: "chunker.rs parses Rust, Go, Python, TypeScript, Java and C/C++ into whole declarations. Over 3,000 non-whitespace characters, a node is split along its children and re-merged. Markdown splits at headings, config files at the size limit."
  }
  embed: Embedder\nONNX Runtime, nomic INT8 {
    class: model
    tooltip: "embedder.rs runs nomic-embed-text v1.5 INT8 through ort with Hugging Face tokenizers. Chunks are sorted by length, batched eight at a time, padded to a power of two, mean-pooled and L2-normalised into 768 dimensions."
  }
  walk -> chunk: changed files
  chunk -> embed: chunks
}

disk: .indexer/ {
  class: zone
  cache: File cache\ncache.bin {
    class: store
    tooltip: "A bincode list of path, SHA-256 and modification time per file. It is saved at the end of an index run, and files that failed to index are dropped from it so they are retried next time."
  }
  vectors: VectorStore\nvectors.bin + HNSW {
    class: store
    tooltip: "store.rs keeps an append-only record log with tombstones, compacted when dead records outnumber live ones. hnsw.rs builds a graph snapshot (vectors.hnsw) at 1,000 records or more. A stale or inconsistent snapshot falls back to an exact scan."
  }
  bm25: Bm25Index\nTantivy {
    class: store
    tooltip: "bm25.rs stores chunk text with its path and line range in a Tantivy index. Queries use the lenient parser, so code-shaped input such as foo::bar() never fails to parse."
  }
}

ask: query command\nCLI {
  class: client
  tooltip: "Embeds the query once with the search_query prefix, then asks the vector store and the BM25 index for 20 candidates each."
}

fuse: rrf_fuse\nk=60, top 5 {
  class: service
  tooltip: "query.rs merges the two ranked lists with Reciprocal Rank Fusion, keyed by file and start line, and prints the top five chunks with file, line range and code."
}

index.walk <-> disk.cache: hash + mtime
index.chunk -> disk.bm25: text
index.embed -> disk.vectors: vectors
ask -> disk.vectors: query vector
ask -> disk.bm25: keywords
disk.vectors -> fuse: top 20
disk.bm25 -> fuse: top 20
