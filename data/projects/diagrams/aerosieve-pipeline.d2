direction: right

audio: Audio files\nwav, mp3, flac, ogg, mp4 {
  class: external
  tooltip: "Recordings from any source. Real corpora are full of silence, hiss, clipping, test tones and phone-line audio."
}

entry: Entry points {
  class: zone
  cli: aerosieve-cli\nclap: curate, inspect {
    class: client
    tooltip: "The aerosieve binary. curate writes shards and prints rejection counts by reason. inspect prints one verdict per clip and writes nothing. --policy loads threshold overrides from JSON."
  }
  bindings: Python and WASM\nPyO3, wasm-bindgen {
    class: client
    tooltip: "bindings/python (inspect and curate, built with maturin) and bindings/wasm (the browser demo). The WASM build decodes and scores once, then re-applies a policy to stored measurements on every slider move."
  }
  serve: aerosieve-serve\naxum WebSocket {
    class: client
    tooltip: "Serves /v1/stream, /metrics and /healthz. Each session holds a LiveInspector. Sessions, utterance length, frame size and idle time are capped, and a hand-written histogram tracks decision latency."
  }
}

core: aerosieve library {
  class: zone
  decode: aerosieve-decode\nSymphonia, rubato {
    class: service
    tooltip: "Decodes any container Symphonia can read, downmixes, resamples to 16 kHz and levels RMS toward -20 dBFS within 3 dB. It keeps the applied gain so full_scale() can recover the source's own peak."
  }
  segment: aerosieve-segment\nhysteresis VAD {
    class: service
    tooltip: "A SpeechDetector scores each 32 ms window. EnergyDetector is the default and Silero via ONNX Runtime is a cargo feature. A state machine ends a clip after 500 ms of quiet, keeps 3 to 30 s, and cuts long runs at their deepest dip."
  }
  acoustic: aerosieve-acoustic\nscore + FilterPolicy {
    class: service
    tooltip: "score returns WADA-SNR, RMS dBFS, clip ratio and spectral flatness, with no ML model. FilterPolicy::evaluate returns the first failing RejectReason, or none if the clip is kept."
  }
  shard: aerosieve-shard\nWebDataset writer {
    class: service
    tooltip: "Writes each kept clip as a .wav and .json pair in shard-*.tar, plus manifest.jsonl and stats.json. Shards are built in a staging directory and renamed into the output directory when complete."
  }
  decode -> segment: 16 kHz mono
  segment -> acoustic: clips
  acoustic -> shard: kept
}

out: Training data {
  class: store
  tooltip: "shard-*.tar, manifest.jsonl and stats.json in the output directory. Only kept clips are stored. Rejection reasons are counted in the run totals and shown per clip by inspect and the live service."
}

audio -> entry.cli: files
audio -> entry.bindings: files or bytes
entry.cli -> core.decode: Pipeline
entry.bindings -> core.decode: Inspector
entry.serve -> core.segment: PCM s16le
core.shard -> out: tar
