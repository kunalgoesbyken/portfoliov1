direction: right

surfaces: Same core, four surfaces {
  class: zone
  batch: CLI, crate, Python {
    class: client
    tooltip: "aerosieve-cli on crates.io, the Rust library, and PyO3 bindings for Python. Batch runs inspect files in parallel with rayon and write results in input order, so shards are byte-identical to a single-threaded run."
  }
  live: WebSocket service {
    class: client
    tooltip: "axum and tokio. Memory per session is bounded by the utterance in progress, and sessions and frame sizes are capped. It held 1,000 concurrent streams on a 4-core laptop with verdicts at 14.8 ms p95 and zero failures."
  }
  wasm: Browser, via WASM {
    class: client
    tooltip: "Decode, segment and score compiled to a 1.7 MB WebAssembly module. Audio never leaves the page, and moving a threshold re-applies the policy to stored measurements without decoding again."
  }
}

audio: Raw recordings\nany format {
  class: external
  tooltip: "wav, mp3, flac, ogg or mp4 from any source. Real corpora are full of silence, hiss, clipping, test tones and phone-line audio."
}

core: AeroSieve core (Rust) {
  class: zone
  decode: Decode\n16 kHz mono {
    class: service
    tooltip: "Converts to 16 kHz mono and levels loudness, but remembers the source full scale. Without that, leveling hid clipping; the benchmark caught this bug."
  }
  segment: Segment\n3 to 30 s clips {
    class: service
    tooltip: "A hysteresis state machine modelled on Silero speech timestamps: start above one threshold, continue above a lower one, end after 500 ms of quiet. Bridging short pauses raised kept Hindi speech from 16.4 to 25.6 minutes. Batch mode is this same streaming segmenter fed the whole file."
  }
  score: Score + policy\nSNR, level, clipping {
    class: service
    tooltip: "Four deterministic numbers with no ML model: WADA-SNR, RMS level, clip ratio and spectral flatness over 300 to 3400 Hz. Measurement and judgement are separate, so thresholds change without re-reading audio."
  }
  decode -> segment -> score
}

out: Output {
  class: zone
  shards: Training shards\nWebDataset {
    class: store
    tooltip: "Tar shards with audio plus JSON per clip, a manifest.jsonl and stats.json, ready for a training data loader."
  }
  rejects: Rejected clips\nwith a reason {
    class: store
    tooltip: "Every dropped clip names its first failing check: low_snr, clipping, tonal, too_quiet, too_loud or silence. SieveBench caught 24,385 of 24,409 injected defects and named the right one for all but 2."
  }
}

audio -> core.decode
surfaces.batch -> core.decode
surfaces.live -> core.segment: PCM
surfaces.wasm -> core.decode
core.score -> out.shards: keep
core.score -> out.rejects: drop
