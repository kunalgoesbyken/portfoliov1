direction: right

guest: Guest side, Go built for wasip1 {
  class: zone
  workload: Workload\nsim package {
    class: client
    tooltip: "A small Go program built with the stock toolchain that drives the cluster. It imports sim for Always, Eventually and Sometimes properties, Put and Get history records, sim.Budget and sim.Listen. Outside the simulator, sim.Listen and sim.Dial call the standard net package."
  }
  service: Your Go service\nunmodified {
    class: external
    tooltip: "Each node package is built with GOOS=wasip1. No forked runtime and no source rewriting. Code that needs cgo cannot build, and mmap or flock code needs a built-in or hand-written shim."
  }
}

host: Host side, the seedfall process {
  class: zone
  runtime: wazero\nengine.Runner {
    class: service
    tooltip: "Compiles each guest once, after adding a call counter to every function in the wasm (instrument.go), and caches the result in .seedfall/cache. Every node start or restart is a fresh module instance."
  }
  sched: world.loop\nseeded scheduler {
    class: service
    tooltip: "Runs exactly one node at a time. It picks the earliest fault, restart or wake-up, breaks ties with the seed and jumps virtual time forward. The clock, random_get (ChaCha8) and poll_oneoff are the three WASI calls it implements."
  }
  disk: memfs.go\nin-memory disk {
    class: store
    tooltip: "One file system per node with a page cache: Sync makes writes durable and a crash keeps only durable data. Options add torn writes, reordered page writeback, strict_dirs, fsync EIO, full disks, lost writes and bit flips."
  }
  net: net.go\nsimulated network {
    class: service
    tooltip: "Ordered TCP streams with seeded latency and UDP datagrams that can reorder, drop or duplicate. Faults are rules on one direction of a link, so one-way partitions fall out of the same code."
  }
  check: history checker\nPorcupine {
    class: service
    tooltip: "After the run, Put and Get records are checked for linearizability with Porcupine against a sequential model. With the list-append model, an in-house Elle-style checker looks for isolation anomalies in sim.Txn histories."
  }
  runtime -> sched: WASI calls
  runtime -> disk: file I/O
  runtime -> net: sockets
  sched -> disk: crashes
  sched -> net: partitions
}

out: Seed + trace\nreplay, shrink {
  class: client
  tooltip: "The result holds the seed, fault list, trace and a hash over every host call. replay, shrink and verify all start from the seed, and run -check runs each seed twice and stops at the first host call that differs."
}

guest.workload -> host.runtime
guest.service -> host.runtime: wasm
host.runtime -> host.check: history
host.check -> out: verdict
host.sched -> out: trace
