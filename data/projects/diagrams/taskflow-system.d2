direction: right

browser: Client components\nTanStack Query, dnd-kit {
  class: client
  tooltip: "Fetches and mutates through route handlers with TanStack Query. The timezone lanes use dnd-kit and call the reassign route on drop. Realtime hooks only invalidate the query cache."
}

app: Next.js on Vercel (bom1) {
  class: zone
  mw: middleware.ts\nsession guard {
    class: service
    tooltip: "Runs on page routes only, not on /api. Refreshes the Supabase session cookie and redirects signed-out visitors from /dashboard, /tasks, /analytics and /settings to /login."
  }
  pages: Server components\ndashboard, lanes, task {
    class: service
    tooltip: "Call getAuthUser(), then read tasks through Prisma with the same creator-or-assignee filter as the API, so the first render already has data."
  }
  routes: Route handlers\nrequireAuth + Zod + Prisma {
    class: service
    tooltip: 'Every handler verifies the user with Supabase, validates input with Zod and scopes task queries to the creator or assignee. The bulk route runs updateMany and the audit createMany in one prisma.$transaction.'
  }
}

supabase: Supabase {
  class: zone
  auth: Auth {
    class: external
    tooltip: "Email and password plus GitHub OAuth. The demo sign-in creates its user with the service role key on first use, then seeds a workspace with fixed ids and skip-duplicates."
  }
  db: Postgres\nPrisma, 7 tables {
    class: store
    tooltip: "Tasks, task events, notifications, users, handoff templates, GitHub tokens and Slack installations. Composite indexes on assignee and creator with updatedAt back the dashboard query. Queries use the pooled URL, migrations the direct URL."
  }
  realtime: Realtime\npostgres_changes {
    class: external
    tooltip: "Task and notification changes arrive as signals. Payloads carry no joined rows, so each event invalidates the query cache and the client refetches the full shape from the API."
  }
  db -> realtime: changes
}

github: GitHub\nsigned webhooks {
  class: external
  tooltip: "Posts issue and pull request events. The route recomputes the HMAC-SHA256 signature with a timing-safe compare before it marks linked tasks done or reopens them."
}

gemini: Gemini 2.5 Flash Lite\nShift Brief {
  class: model
  tooltip: "The shift-brief route sends the caller's tasks updated in the last 24 hours or 7 days as a prompt and relays the response as server-sent events, with a 15 second timeout."
}

browser -> app.mw: page request
app.mw -> app.pages: signed in
app.mw -> supabase.auth: refresh cookie
browser -> app.routes: fetch
app.routes -> supabase.auth: getUser
app.pages -> supabase.db: Prisma
app.routes -> supabase.db: Prisma
browser -> supabase.realtime: subscribe
github -> app.routes: webhook
app.routes -> gemini: stream
