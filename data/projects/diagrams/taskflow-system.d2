direction: right

browser: Browser\nTanStack Query {
  class: client
  tooltip: "Server components render the first view through Prisma; client components fetch and mutate through TanStack Query. Drag and drop between timezone lanes uses dnd-kit."
}

app: Next.js on Vercel {
  class: zone
  guard: Middleware\nsession guard {
    class: service
    tooltip: "Refreshes the Supabase session cookie on each request and redirects signed-out visitors away from the dashboard, tasks, analytics and settings."
  }
  api: Route handlers\nper-user scope {
    class: service
    tooltip: "26 handlers. Every query is scoped to tasks the caller created or is assigned. Bulk changes first verify access to every id, then run one updateMany plus one createMany for the audit trail: 2 statements for any batch size."
  }
  guard -> api
}

supabase: Supabase {
  class: zone
  auth: Auth {
    class: external
    tooltip: "Email and password plus GitHub OAuth. The demo sign-in creates its user on first use and seeds a workspace with fixed ids and skip-duplicates, so concurrent first visitors cannot create copies."
  }
  db: Postgres\nvia Prisma {
    class: store
    tooltip: "7 tables. Composite indexes on assignee and creator with updatedAt back the dashboard query. Pooled connections for queries, a direct URL for migrations."
  }
  realtime: Realtime\nchange signals {
    class: external
    tooltip: "Change payloads carry no joined rows, so each event only invalidates the TanStack Query cache and the client refetches the same joined shape the API returns. One data path instead of two."
  }
  db -> realtime
}

github: GitHub\nsigned webhooks {
  class: external
  tooltip: "Webhooks are verified by recomputing the HMAC with a timing-safe compare. Stored GitHub tokens are encrypted with AES-256-GCM."
}

gemini: Gemini\nShift Brief {
  class: model
  tooltip: "Summarises what changed in the last day or week from the user's recently updated tasks, streamed back as server-sent events."
}

browser -> app.guard
app.guard -> supabase.auth: refresh
app.api -> supabase.db
browser -> supabase.realtime: subscribe
github -> app.api
app.api -> gemini: stream
